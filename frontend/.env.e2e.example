# Playwright E2E — kopyala: copy .env.e2e.example .env.e2e
# .env.e2e commit edilmez.

E2E_BASE_URL=http://localhost:5173
E2E_API_BASE_URL=http://localhost:8080/api/v1

# Dev seed ADMIN (DevDataInitializer) — şifreyi buraya koy; repo’ya gerçek secret yazma.
E2E_ADMIN_EMAIL=admin@kolaysoft.com.tr
E2E_ADMIN_PASSWORD=

# Opsiyonel: sabit CTO kullanıcısı. Boş bırakılırsa admin-workflow anlık CTO üretir.
E2E_CTO_EMAIL=
E2E_CTO_PASSWORD=
