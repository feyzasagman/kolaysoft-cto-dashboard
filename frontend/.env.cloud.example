# Cloud / Render Static Site build-time variable (not committed secrets).
# Set in Render Dashboard → Environment (or Blueprint sync:false) before build.
#
# Example (replace with your real backend hostname after first API deploy):
# VITE_API_BASE_URL=https://cto-dashboard-api.onrender.com/api/v1
#
# Local Vite still uses .env / .env.example → http://localhost:8080/api/v1
# Docker Compose still builds with ARG VITE_API_BASE_URL=/api/v1

VITE_API_BASE_URL=https://YOUR-BACKEND-SERVICE.onrender.com/api/v1
